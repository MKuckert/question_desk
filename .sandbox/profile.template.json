{
  "$schema": "/Users/mkuckert/.nono-here/nono-profile.schema.json",
  "extends": ["nolabs-ai/claude"],
  "groups": { "include": ["rust_runtime"] },
  "meta": {
    "name": "ask_user_question_ui",
    "version": "12"
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [
      "~/.cargo/",
      "~/Library/Application Support/question-desk",
      "~/.agents/skills/",
      "~/.config/question-desk"
    ],
    "deny": ["~/.gitconfig"],
    "read_file": [
      "~/.gitconfig-private",
      "~/.gitconfig-work",
      "~/.gitconfig-agents",
      "~/.gitignore",
      "~/.bashrc",
      "~/.bashprofile"
    ],
    "read": ["~/.config/gh", "~/.CFUserTextEncoding"],
    "bypass_protection": ["~/.bashrc", "~/.bashprofile"]
  },
  "network": {
    "allow_domain": []
  },
  "allow_gpu": true,
  "unsafe_macos_seatbelt_rules": [
    "(allow iokit-open (iokit-user-client-class \"RootDomainUserClient\") (iokit-user-client-class \"IOSurfaceRootUserClient\"))",
    "(allow iokit-get-properties)",
    "(allow mach-register)"
  ],
  "environment": {
    "allow_vars": [
      "HOME",
      "SHELL",
      "TERM",
      "PATH",
      "LSCOLORS",
      "LS_COLORS",
      "LC_ALL",
      "LANG",
      "PWD",
      "USER",
      "EDITOR",
      "DO_NOT_TRACK"
    ],
    "set_vars": {
      "CLAUDE_CODE_GLOB_NO_IGNORE": "false",
      "CLAUDE_CODE_HIDE_CWD": "1",
      "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "5",
      "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3",
      "CLAUDE_CODE_MAX_TURNS": "200",
      "CLAUDE_CODE_RESUME_INTERRUPTED_TURN": "0",
      "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
      "CLAUDE_CODE_DISABLE_ARTIFACT": "1",
      "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
      "DISABLE_AUTO_COMPACT": "1",
      "DISABLE_FEEDBACK_COMMAND": "1",
      "DISABLE_INSTALL_GITHUB_APP_COMMAND": "1",
      "DISABLE_UPGRADE_COMMAND": "1",
      "GIT_CONFIG_GLOBAL": "~/.gitconfig-agents"
    }
  }
}
